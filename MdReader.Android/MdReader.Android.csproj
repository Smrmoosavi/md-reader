<Project Sdk="Microsoft.NET.Sdk">

  <!-- Avalonia 12 only ships an Android build for net10.0-android, so this head needs the
       .NET 10 SDK plus the `android` workload. The shared library still targets net8.0. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MdReader.Droid</RootNamespace>
    <AssemblyName>MdReader.Android</AssemblyName>
    <ApplicationId>com.smrmoosavi.mdreader</ApplicationId>
    <!-- Version comes from Directory.Build.props; ApplicationVersion is the store build number. -->
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>6</ApplicationVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MdReader.Shared\MdReader.Shared.csproj" />
  </ItemGroup>

</Project>
