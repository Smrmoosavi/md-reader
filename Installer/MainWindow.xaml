<Window x:Class="MdReaderSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نصب MD Reader"
        Width="600" Height="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Segoe UI, Tahoma"
        FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="MutedBrush" Color="#6B7580" />
        <SolidColorBrush x:Key="LineBrush" Color="#E3E8EE" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1D6FE0" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#195FBF" />

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="22,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#24292F" />
            <Setter Property="BorderBrush" Value="#D5DCE3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F3F6F9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid FlowDirection="RightToLeft">
        <Grid x:Name="InstallPanel" Margin="28,24,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,22">
                <Border Width="46" Height="46" CornerRadius="10" Background="#2563EB" VerticalAlignment="Top">
                    <TextBlock Text="MD" Foreground="White" FontSize="17" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="نصب MD Reader" FontSize="20" FontWeight="SemiBold" Foreground="#1F2328" />
                    <TextBlock Text="خواننده‌ی سبک فایل‌های Markdown با پشتیبانی راست‌به‌چپ"
                               Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <TextBlock Text="پوشه‌ی نصب" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                <DockPanel LastChildFill="True">
                    <Button Content="تغییر…" DockPanel.Dock="Left" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="Browse_Click" />
                    <TextBox x:Name="DirBox" Padding="8,6" VerticalContentAlignment="Center"
                             FontFamily="Segoe UI, Consolas" />
                </DockPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                <CheckBox x:Name="AssociateCheck" IsChecked="True" Margin="0,0,0,10">
                    <TextBlock>
                        ثبت برنامه به‌عنوان بازکننده‌ی فایل‌های
                        <Run FlowDirection="LeftToRight">.md</Run>
                        <Run Text="و" />
                        <Run FlowDirection="LeftToRight">.markdown</Run>
                    </TextBlock>
                </CheckBox>
                <CheckBox x:Name="StartMenuCheck" Content="ساخت میانبر در منوی استارت" IsChecked="True" Margin="0,0,0,10" />
                <CheckBox x:Name="DesktopCheck" Content="ساخت میانبر روی دسکتاپ" />
            </StackPanel>

            <Border Grid.Row="3" Background="#F7F9FB" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10" VerticalAlignment="Top">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"
                           Text="اگر ویندوز از قبل برنامه‌ی دیگری را برای باز کردن فایل‌های Markdown انتخاب کرده باشد، ممکن است یک‌بار تأیید تغییر پیش‌فرض را نشان دهد. آیکون فایل‌ها بعد از نصب روی همان آیکون MD Reader می‌شود." />
            </Border>

            <StackPanel Grid.Row="4" Margin="0,14,0,14">
                <ProgressBar x:Name="Progress" Height="4" IsIndeterminate="True" Visibility="Collapsed"
                             Background="#E8EDF3" Foreground="{StaticResource PrimaryBrush}" />
                <TextBlock x:Name="StatusText" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" FontSize="12" />
            </StackPanel>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="InstallButton" Content="نصب" Style="{StaticResource PrimaryButton}"
                        Click="Install_Click" IsDefault="True" />
                <Button x:Name="CancelButton" Content="انصراف" Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0" Click="Cancel_Click" IsCancel="True" />
            </StackPanel>
        </Grid>

        <Grid x:Name="DonePanel" Margin="40" Visibility="Collapsed" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="نصب کامل شد" FontSize="24" FontWeight="SemiBold" Foreground="#1F2328"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="DonePath" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}"
                           TextAlignment="Center" TextWrapping="Wrap"
                           FlowDirection="LeftToRight" />
                <TextBlock Text="حالا فایل‌های Markdown با آیکون MD Reader باز می‌شوند."
                           Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextAlignment="Center"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                    <Button Content="باز کردن MD Reader" Style="{StaticResource PrimaryButton}" Click="Open_Click" />
                    <Button Content="پایان" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            Click="Cancel_Click" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
