<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MdReader"
             xmlns:rendering="using:MdReader.Rendering"
             x:Class="MdReader.MainView"
             Background="{DynamicResource AppBackground}"
             FontSize="13">

    <UserControl.Styles>
        <Style Selector="Button.tabclose">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tabclose:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- Tab titles keep their own size on every platform; Windows otherwise inherits a much
             larger header font from the Fluent theme. -->
        <Style Selector="TabStrip > TabItem">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="10,1" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TabStrip > TabItem TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.outline">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource AppText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.outline:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
        <Style Selector="Button.outline.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppActiveBackground}" />
        </Style>
        <Style Selector="Button.outline.active">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppLink}" />
        </Style>
        <Style Selector="Button.outline TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="Button.library">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.library:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>

        <Style Selector="Button.mark">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource AppText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.mark:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
        <Style Selector="Button.markdelete">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.markdelete:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <Border x:Name="ToolbarBorder"
                Grid.Row="0"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="0,0,0,1"
                Padding="10,10,10,4">
            <WrapPanel x:Name="ToolbarPanel"
                       Orientation="Horizontal"
                       FlowDirection="RightToLeft">
                <Button x:Name="NewButton"
                        Classes="tool"
                        Content="{DynamicResource New}"
                        Click="NewButton_Click"
                        AutomationProperties.Name="{DynamicResource NewTip}"
                        ToolTip.Tip="{DynamicResource NewTip}" />
                <Button x:Name="OpenButton"
                        Classes="tool"
                        Content="{DynamicResource Open}"
                        Click="OpenButton_Click" />
                <Button x:Name="SaveButton"
                        Classes="tool"
                        Content="{DynamicResource Save}"
                        Click="SaveButton_Click"
                        IsEnabled="False"
                        AutomationProperties.Name="{DynamicResource SaveTip}"
                        ToolTip.Tip="{DynamicResource SaveTip}" />
                <ToggleButton x:Name="EditToggle"
                              Classes="tool"
                              Content="{DynamicResource Edit}"
                              IsCheckedChanged="EditToggle_Changed"
                              AutomationProperties.Name="{DynamicResource EditTip}"
                              ToolTip.Tip="{DynamicResource EditTip}" />
                <Button x:Name="ReloadButton"
                        Classes="tool"
                        Content="{DynamicResource Reload}"
                        Click="ReloadButton_Click"
                        IsEnabled="False" />

                <Rectangle Width="1" Height="22" Margin="8,4,14,10" Fill="{DynamicResource PanelBorder}" VerticalAlignment="Center" />

                <Button Classes="tool"
                        Content="A+"
                        Click="ZoomIn_Click"
                        AutomationProperties.Name="{DynamicResource ZoomInTip}"
                        ToolTip.Tip="{DynamicResource ZoomInTip}" />
                <Button Classes="tool"
                        Content="A−"
                        Click="ZoomOut_Click"
                        AutomationProperties.Name="{DynamicResource ZoomOutTip}"
                        ToolTip.Tip="{DynamicResource ZoomOutTip}" />

                <Rectangle Width="1" Height="22" Margin="8,4,14,10" Fill="{DynamicResource PanelBorder}" VerticalAlignment="Center" />

                <Button Classes="tool"
                        Content="{DynamicResource Search}"
                        Click="SearchButton_Click"
                        ToolTip.Tip="{DynamicResource SearchTip}" />
                <ToggleButton x:Name="TocToggle"
                              Classes="tool"
                              Content="{DynamicResource Outline}"
                              IsCheckedChanged="TocToggle_Changed"
                              ToolTip.Tip="{DynamicResource OutlineTip}" />
                <ToggleButton x:Name="LibraryToggle"
                              Classes="tool"
                              Content="{DynamicResource Library}"
                              IsCheckedChanged="LibraryToggle_Changed"
                              ToolTip.Tip="{DynamicResource LibraryTip}" />
                <ToggleButton x:Name="MarksToggle"
                              Classes="tool"
                              Content="{DynamicResource Marks}"
                              IsCheckedChanged="MarksToggle_Changed"
                              ToolTip.Tip="{DynamicResource MarksTip}" />
                <ToggleButton x:Name="FocusToggle"
                              Classes="tool"
                              Content="{DynamicResource Focus}"
                              Click="FocusToggle_Click"
                              ToolTip.Tip="{DynamicResource FocusTip}" />

                <Button Classes="tool"
                        Content="{DynamicResource Export}"
                        ToolTip.Tip="{DynamicResource ExportTip}">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="{DynamicResource CopyRichText}" Click="CopyRichText_Click" />
                            <MenuItem Header="{DynamicResource SavePdf}" Click="ExportPdf_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Reading options live behind this gear so the toolbar stays short. -->
                <Button x:Name="SettingsButton"
                        Classes="tool"
                        Content="⚙"
                        FontSize="15"
                        Click="SettingsButton_Click"
                        AutomationProperties.Name="{DynamicResource Settings}"
                        ToolTip.Tip="{DynamicResource Settings}" />
            </WrapPanel>
        </Border>

        <TabStrip x:Name="DocTabs"
                  Grid.Row="1"
                  Background="{DynamicResource PanelBackground}"
                  FlowDirection="RightToLeft"
                  IsVisible="False"
                  SelectionChanged="DocTabs_SelectionChanged">
            <TabStrip.ItemTemplate>
                <DataTemplate x:DataType="local:DocumentTab">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Header}"
                                   FontSize="12"
                                   MaxWidth="220"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding ToolTip}" />
                        <Button Classes="tabclose"
                                Content="✕"
                                Click="CloseTab_Click"
                                AutomationProperties.Name="{DynamicResource CloseTab}"
                                ToolTip.Tip="{DynamicResource CloseTab}" />
                    </StackPanel>
                </DataTemplate>
            </TabStrip.ItemTemplate>
        </TabStrip>

        <Border x:Name="SearchBar"
                Grid.Row="2"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="0,0,0,1"
                Padding="10,6"
                IsVisible="False">
            <Grid x:Name="SearchBarGrid" ColumnDefinitions="*,Auto,Auto,Auto,Auto" FlowDirection="RightToLeft">
                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         MinHeight="30"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         PlaceholderText="{DynamicResource SearchPlaceholder}"
                         TextChanged="SearchBox_TextChanged"
                         KeyDown="SearchBox_KeyDown" />
                <TextBlock x:Name="SearchCountText"
                           Grid.Column="1"
                           Margin="12,0,12,0"
                           FontSize="12"
                           Foreground="{DynamicResource AppTextMuted}"
                           VerticalAlignment="Center"
                           ToolTip.Tip="{DynamicResource SearchHint}" />
                <Button Grid.Column="2"
                        Classes="tool"
                        Content="{DynamicResource Previous}"
                        Click="SearchPrev_Click" />
                <Button Grid.Column="3"
                        Classes="tool"
                        Content="{DynamicResource Next}"
                        Click="SearchNext_Click" />
                <Button Grid.Column="4"
                        Classes="tool"
                        Content="✕"
                        Click="SearchClose_Click"
                        AutomationProperties.Name="{DynamicResource CloseSearch}"
                        ToolTip.Tip="{DynamicResource CloseSearch}" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto">
            <Border x:Name="MarksPanel"
                    Grid.Column="0"
                    Width="250"
                    Background="{DynamicResource PanelAltBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="0,0,1,0"
                    Padding="8,10"
                    IsVisible="False">
                <DockPanel x:Name="MarksDock" LastChildFill="True" FlowDirection="RightToLeft">
                    <TextBlock DockPanel.Dock="Top"
                               Text="{DynamicResource MarksTitle}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextMuted}"
                               Margin="4,0,4,8" />
                    <Button DockPanel.Dock="Top"
                            Classes="tool"
                            Content="{DynamicResource AddBookmark}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,6"
                            Click="AddBookmark_Click" />
                    <TextBox x:Name="NoteBox"
                             DockPanel.Dock="Top"
                             MinHeight="54"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Margin="0,0,0,6"
                             PlaceholderText="{DynamicResource NotePlaceholder}" />
                    <Button DockPanel.Dock="Top"
                            Classes="tool"
                            Content="{DynamicResource AddNote}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,10"
                            Click="AddNote_Click" />
                    <TextBlock x:Name="MarksEmptyText"
                               DockPanel.Dock="Top"
                               Text="{DynamicResource MarksEmpty}"
                               FontSize="11"
                               Foreground="{DynamicResource AppTextSoft}"
                               TextWrapping="Wrap"
                               Margin="4,0,4,0" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="MarksList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:DocumentMark">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Button Classes="mark"
                                                Grid.Column="1"
                                                Click="MarkItem_Click"
                                                ToolTip.Tip="{DynamicResource ResumeTip}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Glyph}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Text}"
                                                           FontSize="12"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="170"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="markdelete"
                                                Grid.Column="0"
                                                Content="✕"
                                                Click="MarkDelete_Click"
                                                AutomationProperties.Name="{DynamicResource DeleteMark}"
                                                ToolTip.Tip="{DynamicResource DeleteMark}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border x:Name="LibraryPanel"
                    Grid.Column="1"
                    Width="290"
                    Background="{DynamicResource PanelAltBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="0,0,1,0"
                    Padding="8,10"
                    IsVisible="False">
                <DockPanel x:Name="LibraryDock" LastChildFill="True" FlowDirection="RightToLeft">
                    <TextBlock DockPanel.Dock="Top"
                               Text="{DynamicResource LibraryTitle}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextMuted}"
                               Margin="4,0,4,6" />
                    <Button DockPanel.Dock="Top"
                            Classes="tool"
                            Content="{DynamicResource ChooseFolder}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,6"
                            Click="ChooseLibraryFolder_Click" />
                    <TextBlock x:Name="LibraryPathText"
                               DockPanel.Dock="Top"
                               Text="{DynamicResource NoFolder}"
                               FontSize="11"
                               Foreground="{DynamicResource AppTextSoft}"
                               TextTrimming="CharacterEllipsis"
                               Margin="4,0,4,8" />
                    <TextBox x:Name="LibrarySearchBox"
                             DockPanel.Dock="Top"
                             MinHeight="30"
                             Margin="0,0,0,6"
                             PlaceholderText="{DynamicResource LibraryPlaceholder}"
                             TextChanged="LibrarySearchBox_TextChanged" />
                    <TextBlock x:Name="LibraryStatusText"
                               DockPanel.Dock="Bottom"
                               FontSize="11"
                               Foreground="{DynamicResource AppTextSoft}"
                               Margin="4,6,4,0"
                               TextWrapping="Wrap" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LibraryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:LibraryItem">
                                    <Button Classes="library" Click="LibraryItem_Click" ToolTip.Tip="{Binding FullPath}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Header}"
                                                       FontSize="12"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,*" Margin="0,1,0,0">
                                                <TextBlock Text="{Binding LineNumber}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AppTextMuted}"
                                                           Margin="0,0,4,0" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SnippetBefore}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AppTextMuted}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="80" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding SnippetMatch}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppText}"
                                                           Background="{DynamicResource MatchBackground}"
                                                           TextWrapping="NoWrap" />
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding SnippetAfter}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AppTextMuted}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <TextBlock Text="{Binding Detail}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource AppTextMuted}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding !HasSnippet}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Panel Grid.Column="2" Background="{DynamicResource AppBackground}">
                <ScrollViewer x:Name="DocScroll"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Panel x:Name="DocHost" />
                </ScrollViewer>

                <!-- The same document as plain Markdown; the reader and the editor share the
                     buffer, so Ctrl + S, search and export always see what is typed. -->
                <ScrollViewer x:Name="EditorScroll"
                              IsVisible="False"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="EditorBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontSize="16"
                             Padding="28,20,28,40"
                             MinHeight="400"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Top"
                             TextChanged="EditorBox_TextChanged" />
                </ScrollViewer>
            </Panel>

            <Border x:Name="OutlinePanel"
                    Grid.Column="3"
                    Width="250"
                    Background="{DynamicResource PanelAltBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1,0,0,0"
                    Padding="6,10"
                    IsVisible="False">
                <DockPanel x:Name="OutlineDock" LastChildFill="True" FlowDirection="RightToLeft">
                    <TextBlock DockPanel.Dock="Top"
                               Text="{DynamicResource OutlineTitle}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextMuted}"
                               Margin="8,0,8,8" />
                    <TextBlock x:Name="OutlineEmpty"
                               DockPanel.Dock="Top"
                               Text="{DynamicResource OutlineEmpty}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource AppTextSoft}"
                               Margin="8,0,8,0"
                               IsVisible="False" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="OutlineList" FlowDirection="RightToLeft">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="rendering:OutlineEntry">
                                    <Button Classes="outline"
                                            Classes.active="{Binding IsActive}"
                                            Content="{Binding Title}"
                                            Margin="{Binding Indent}"
                                            Click="OutlineItem_Click"
                                            ToolTip.Tip="{Binding Title}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border x:Name="StatusBorder"
                Grid.Row="4"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="0,1,0,0"
                Padding="12,7">
            <DockPanel x:Name="StatusPanel" LastChildFill="True" FlowDirection="RightToLeft">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Name="ProgressText"
                               FontSize="12"
                               Foreground="{DynamicResource AppTextMuted}"
                               VerticalAlignment="Center"
                               ToolTip.Tip="{DynamicResource ProgressTip}" />
                    <TextBlock x:Name="CountText"
                               FontSize="12"
                               Foreground="{DynamicResource AppTextMuted}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="FileText"
                           Text="{DynamicResource NoFile}"
                           TextAlignment="Start"
                           FontSize="12"
                           Foreground="{DynamicResource AppTextMuted}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Border x:Name="SettingsPanel"
                Grid.Row="0"
                Grid.RowSpan="5"
                Width="300"
                Margin="0,8,12,12"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                IsVisible="False"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12"
                BoxShadow="0 6 18 0 #40000000">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource Settings}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Classes="tabclose"
                            Content="✕"
                            Click="SettingsClose_Click"
                            AutomationProperties.Name="{DynamicResource CloseSettings}"
                            ToolTip.Tip="{DynamicResource CloseSettings}" />
                </Grid>

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SettingsStack" Spacing="10" Margin="0,0,4,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{DynamicResource Direction}" Classes="label" />
                            <ComboBox x:Name="DirectionCombo"
                                      MinHeight="30"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="DirectionCombo_Changed" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="{DynamicResource Font}" Classes="label" />
                            <ComboBox x:Name="FontCombo"
                                      MinHeight="30"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="FontCombo_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:FontChoice">
                                        <TextBlock Text="{Binding Label}" FontFamily="{Binding Family}" FontSize="14" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="{DynamicResource Size}" Classes="label" />
                            <Grid ColumnDefinitions="*,*,Auto,Auto">
                                <ComboBox x:Name="SizeCombo"
                                          Grid.Column="0"
                                          MinHeight="30"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="SizeCombo_SelectionChanged" />
                                <Button Grid.Column="2"
                                        Classes="tool"
                                        Content="A+"
                                        Margin="6,0,0,0"
                                        Click="ZoomIn_Click"
                                        ToolTip.Tip="{DynamicResource ZoomInTip}" />
                                <Button Grid.Column="3"
                                        Classes="tool"
                                        Content="A−"
                                        Margin="4,0,0,0"
                                        Click="ZoomOut_Click"
                                        ToolTip.Tip="{DynamicResource ZoomOutTip}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="{DynamicResource Width}" Classes="label" />
                            <ComboBox x:Name="WidthCombo"
                                      MinHeight="30"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="WidthCombo_Changed" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="{DynamicResource Theme}" Classes="label" />
                            <ComboBox x:Name="ThemeCombo"
                                      MinHeight="30"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="ThemeCombo_Changed" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="{DynamicResource Language}" Classes="label" />
                            <ComboBox x:Name="LanguageCombo"
                                      MinHeight="30"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="LanguageCombo_Changed" />
                        </StackPanel>

                        <CheckBox x:Name="AutoReloadCheck"
                                  Content="{DynamicResource AutoReload}"
                                  Margin="0,4,0,0"
                                  IsCheckedChanged="AutoReloadCheck_Changed"
                                  ToolTip.Tip="{DynamicResource AutoReloadTip}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Closing a document with unsaved edits asks first: nothing is written or dropped
             until one of the three buttons is chosen. -->
        <Border x:Name="UnsavedPanel"
                Grid.Row="0"
                Grid.RowSpan="5"
                Width="380"
                MaxWidth="380"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="False"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,14"
                BoxShadow="0 10 26 0 #40000000">
            <StackPanel x:Name="UnsavedStack" Spacing="10">
                <TextBlock Text="{DynamicResource UnsavedTitle}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="UnsavedText"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppTextMuted}" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right">
                    <Button x:Name="UnsavedSaveButton"
                            Classes="tool"
                            Content="{DynamicResource Save}"
                            Click="UnsavedSave_Click" />
                    <Button Classes="tool"
                            Content="{DynamicResource Discard}"
                            Click="UnsavedDiscard_Click" />
                    <Button Classes="tool"
                            Content="{DynamicResource Cancel}"
                            Click="UnsavedCancel_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Quick open: type part of a file name and press Enter. It sits above the document
             like the settings card, so it works the same on a phone and in a window. -->
        <Border x:Name="QuickOpenPanel"
                Grid.Row="0"
                Grid.RowSpan="5"
                MaxWidth="560"
                Margin="24,64,24,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                IsVisible="False"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                BoxShadow="0 8 22 0 #40000000">
            <StackPanel x:Name="QuickOpenStack" Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="QuickOpenBox"
                             MinHeight="32"
                             VerticalContentAlignment="Center"
                             PlaceholderText="{DynamicResource QuickOpenPlaceholder}"
                             TextChanged="QuickOpenBox_TextChanged"
                             KeyDown="QuickOpenBox_KeyDown" />
                    <Button Grid.Column="1"
                            Classes="tabclose"
                            Content="✕"
                            Margin="6,0,0,0"
                            Click="QuickOpenClose_Click"
                            AutomationProperties.Name="{DynamicResource CloseQuickOpen}"
                            ToolTip.Tip="{DynamicResource CloseQuickOpen}" />
                </Grid>
                <TextBlock x:Name="QuickOpenEmpty"
                           Text="{DynamicResource QuickOpenEmpty}"
                           FontSize="12"
                           Foreground="{DynamicResource AppTextSoft}"
                           Margin="4,0"
                           IsVisible="False" />
                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="QuickOpenList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:QuickEntry">
                                <Button Classes="library" Click="QuickItem_Click" ToolTip.Tip="{Binding Detail}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}"
                                                   FontSize="12"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource AppTextMuted}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
