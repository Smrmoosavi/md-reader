<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MdReader"
             x:Class="MdReader.MainView"
             Background="#FFFFFF"
             FontSize="13">

    <UserControl.Styles>
        <Style Selector="Button.tabclose">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tabclose:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TabStrip > TabItem">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <Border Grid.Row="0"
                Background="#F6F8FA"
                BorderBrush="#E3E8EE"
                BorderThickness="0,0,0,1"
                Padding="10,10,10,4">
            <WrapPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                <Button x:Name="OpenButton"
                        Classes="tool"
                        Content="باز کردن فایل"
                        Click="OpenButton_Click" />
                <Button x:Name="ReloadButton"
                        Classes="tool"
                        Content="بازخوانی"
                        Click="ReloadButton_Click"
                        IsEnabled="False" />

                <Rectangle Width="1" Height="22" Margin="8,4,14,10" Fill="#E3E8EE" VerticalAlignment="Center" />

                <CheckBox x:Name="RtlCheckBox"
                          Content="راست به چپ (RTL)"
                          VerticalAlignment="Center"
                          Margin="0,0,16,6"
                          IsCheckedChanged="RtlCheckBox_Changed" />

                <TextBlock Text="فونت" Classes="label" />
                <ComboBox x:Name="FontCombo"
                          Width="200"
                          Margin="0,0,6,6"
                          MinHeight="30"
                          VerticalAlignment="Center"
                          SelectionChanged="FontCombo_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="14" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="اندازه" Classes="label" />
                <ComboBox x:Name="SizeCombo"
                          Width="72"
                          Margin="0,0,6,6"
                          MinHeight="30"
                          VerticalAlignment="Center"
                          SelectionChanged="SizeCombo_SelectionChanged" />

                <Button Classes="tool"
                        Content="A+"
                        Click="ZoomIn_Click"
                        ToolTip.Tip="بزرگ‌تر کردن فونت (Ctrl + چرخ ماوس به بالا)" />
                <Button Classes="tool"
                        Content="A−"
                        Click="ZoomOut_Click"
                        ToolTip.Tip="کوچک‌تر کردن فونت (Ctrl + چرخ ماوس به پایین)" />
            </WrapPanel>
        </Border>

        <TabStrip x:Name="DocTabs"
                  Grid.Row="1"
                  Background="#F6F8FA"
                  FlowDirection="RightToLeft"
                  IsVisible="False"
                  SelectionChanged="DocTabs_SelectionChanged">
            <TabStrip.ItemTemplate>
                <DataTemplate x:DataType="local:DocumentTab">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Header}"
                                   MaxWidth="220"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding ToolTip}" />
                        <Button Classes="tabclose"
                                Content="✕"
                                Click="CloseTab_Click"
                                ToolTip.Tip="بستن این تب" />
                    </StackPanel>
                </DataTemplate>
            </TabStrip.ItemTemplate>
        </TabStrip>

        <ScrollViewer x:Name="DocScroll"
                      Grid.Row="2"
                      Background="#FFFFFF"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Panel x:Name="DocHost" />
        </ScrollViewer>

        <Border Grid.Row="3"
                Background="#F6F8FA"
                BorderBrush="#E3E8EE"
                BorderThickness="0,1,0,0"
                Padding="12,7">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="CountText"
                           DockPanel.Dock="Left"
                           FlowDirection="RightToLeft"
                           FontSize="12"
                           Foreground="#6B7580"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="FileText"
                           Text="فایلی باز نشده است"
                           FlowDirection="RightToLeft"
                           TextAlignment="Right"
                           FontSize="12"
                           Foreground="#4B5563"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
