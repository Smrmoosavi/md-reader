<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MdReader"
             xmlns:rendering="using:MdReader.Rendering"
             x:Class="MdReader.MainView"
             Background="#FFFFFF"
             FontSize="13">

    <UserControl.Styles>
        <Style Selector="Button.tabclose">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tabclose:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TabStrip > TabItem">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.outline">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#3B4450" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style Selector="Button.outline:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E4EBF3" />
        </Style>
        <Style Selector="Button.outline.active /template/ ContentPresenter">
            <Setter Property="Background" Value="#E4EBF3" />
        </Style>
        <Style Selector="Button.outline.active">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0B62C4" />
        </Style>
        <Style Selector="Button.outline TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="Button.library">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.library:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E4EBF3" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <Border Grid.Row="0"
                Background="#F6F8FA"
                BorderBrush="#E3E8EE"
                BorderThickness="0,0,0,1"
                Padding="10,10,10,4">
            <WrapPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                <Button x:Name="OpenButton"
                        Classes="tool"
                        Content="باز کردن فایل"
                        Click="OpenButton_Click" />
                <Button x:Name="ReloadButton"
                        Classes="tool"
                        Content="بازخوانی"
                        Click="ReloadButton_Click"
                        IsEnabled="False" />

                <Rectangle Width="1" Height="22" Margin="8,4,14,10" Fill="#E3E8EE" VerticalAlignment="Center" />

                <CheckBox x:Name="RtlCheckBox"
                          Content="راست به چپ (RTL)"
                          VerticalAlignment="Center"
                          Margin="0,0,16,6"
                          IsCheckedChanged="RtlCheckBox_Changed" />

                <TextBlock Text="فونت" Classes="label" />
                <ComboBox x:Name="FontCombo"
                          Width="200"
                          Margin="0,0,6,6"
                          MinHeight="30"
                          VerticalAlignment="Center"
                          SelectionChanged="FontCombo_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="local:FontChoice">
                            <TextBlock Text="{Binding Label}" FontFamily="{Binding Family}" FontSize="14" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="اندازه" Classes="label" />
                <ComboBox x:Name="SizeCombo"
                          Width="72"
                          Margin="0,0,6,6"
                          MinHeight="30"
                          VerticalAlignment="Center"
                          SelectionChanged="SizeCombo_SelectionChanged" />

                <Button Classes="tool"
                        Content="A+"
                        Click="ZoomIn_Click"
                        ToolTip.Tip="بزرگ‌تر کردن فونت (Ctrl + چرخ ماوس به بالا)" />
                <Button Classes="tool"
                        Content="A−"
                        Click="ZoomOut_Click"
                        ToolTip.Tip="کوچک‌تر کردن فونت (Ctrl + چرخ ماوس به پایین)" />

                <Rectangle Width="1" Height="22" Margin="8,4,14,10" Fill="#E3E8EE" VerticalAlignment="Center" />

                <Button Classes="tool"
                        Content="جست‌وجو"
                        Click="SearchButton_Click"
                        ToolTip.Tip="جست‌وجو در سند (Ctrl + F)" />
                <ToggleButton x:Name="TocToggle"
                              Classes="tool"
                              Content="فهرست"
                              IsCheckedChanged="TocToggle_Changed"
                              ToolTip.Tip="نمایش یا پنهان کردن فهرست مطالب" />
                <ToggleButton x:Name="LibraryToggle"
                              Classes="tool"
                              Content="کتابخانه"
                              IsCheckedChanged="LibraryToggle_Changed"
                              ToolTip.Tip="نمایش پوشه‌ی یادداشت‌ها و جست‌وجو بین آن‌ها" />
                <CheckBox x:Name="AutoReloadCheck"
                          Content="بازخوانی خودکار"
                          VerticalAlignment="Center"
                          Margin="10,0,0,6"
                          IsCheckedChanged="AutoReloadCheck_Changed"
                          ToolTip.Tip="اگر فایل روی دیسک تغییر کرد، خودکار دوباره خوانده شود" />
                <Button Classes="tool"
                        Content="خروجی"
                        ToolTip.Tip="کپی به‌صورت متن غنی یا ذخیره‌ی PDF">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="کپی متن (غنی)" Click="CopyRichText_Click" />
                            <MenuItem Header="ذخیره به PDF…" Click="ExportPdf_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </WrapPanel>
        </Border>

        <TabStrip x:Name="DocTabs"
                  Grid.Row="1"
                  Background="#F6F8FA"
                  FlowDirection="RightToLeft"
                  IsVisible="False"
                  SelectionChanged="DocTabs_SelectionChanged">
            <TabStrip.ItemTemplate>
                <DataTemplate x:DataType="local:DocumentTab">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Header}"
                                   MaxWidth="220"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding ToolTip}" />
                        <Button Classes="tabclose"
                                Content="✕"
                                Click="CloseTab_Click"
                                ToolTip.Tip="بستن این تب" />
                    </StackPanel>
                </DataTemplate>
            </TabStrip.ItemTemplate>
        </TabStrip>

        <Border x:Name="SearchBar"
                Grid.Row="2"
                Background="#F6F8FA"
                BorderBrush="#E3E8EE"
                BorderThickness="0,0,0,1"
                Padding="10,6"
                IsVisible="False">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" FlowDirection="RightToLeft">
                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         MinHeight="30"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         PlaceholderText="متن موردنظر را بنویسید…"
                         TextChanged="SearchBox_TextChanged"
                         KeyDown="SearchBox_KeyDown" />
                <TextBlock x:Name="SearchCountText"
                           Grid.Column="1"
                           Margin="12,0,12,0"
                           FontSize="12"
                           Foreground="#6B7580"
                           VerticalAlignment="Center"
                           ToolTip.Tip="Enter = نتیجه بعدی، Shift + Enter = نتیجه قبلی، Escape = بستن" />
                <Button Grid.Column="2"
                        Classes="tool"
                        Content="قبلی"
                        Click="SearchPrev_Click" />
                <Button Grid.Column="3"
                        Classes="tool"
                        Content="بعدی"
                        Click="SearchNext_Click" />
                <Button Grid.Column="4"
                        Classes="tool"
                        Content="✕"
                        Click="SearchClose_Click"
                        ToolTip.Tip="بستن جست‌وجو (Escape)" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto">
            <Border x:Name="LibraryPanel"
                    Grid.Column="0"
                    Width="290"
                    Background="#F8FAFC"
                    BorderBrush="#E3E8EE"
                    BorderThickness="0,0,1,0"
                    Padding="8,10"
                    IsVisible="False">
                <DockPanel LastChildFill="True" FlowDirection="RightToLeft">
                    <TextBlock DockPanel.Dock="Top"
                               Text="کتابخانه"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#6B7580"
                               Margin="4,0,4,6" />
                    <Button DockPanel.Dock="Top"
                            Classes="tool"
                            Content="انتخاب پوشه…"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,6"
                            Click="ChooseLibraryFolder_Click" />
                    <TextBlock x:Name="LibraryPathText"
                               DockPanel.Dock="Top"
                               Text="پوشه‌ای انتخاب نشده است."
                               FontSize="11"
                               Foreground="#98A2B3"
                               TextTrimming="CharacterEllipsis"
                               Margin="4,0,4,8" />
                    <TextBox x:Name="LibrarySearchBox"
                             DockPanel.Dock="Top"
                             MinHeight="30"
                             Margin="0,0,0,6"
                             PlaceholderText="جست‌وجو در نام و متن فایل‌ها…"
                             TextChanged="LibrarySearchBox_TextChanged" />
                    <TextBlock x:Name="LibraryStatusText"
                               DockPanel.Dock="Bottom"
                               FontSize="11"
                               Foreground="#98A2B3"
                               Margin="4,6,4,0"
                               TextTrimming="CharacterEllipsis" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LibraryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:LibraryItem">
                                    <Button Classes="library" Click="LibraryItem_Click" ToolTip.Tip="{Binding FullPath}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Header}"
                                                       FontSize="12"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}"
                                                       FontSize="11"
                                                       Foreground="#6B7580"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="DocScroll"
                          Grid.Column="1"
                          Background="#FFFFFF"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Panel x:Name="DocHost" />
            </ScrollViewer>

            <Border x:Name="OutlinePanel"
                    Grid.Column="2"
                    Width="250"
                    Background="#F8FAFC"
                    BorderBrush="#E3E8EE"
                    BorderThickness="1,0,0,0"
                    Padding="6,10"
                    IsVisible="False">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="فهرست مطالب"
                               FlowDirection="RightToLeft"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#6B7580"
                               Margin="8,0,8,8" />
                    <TextBlock x:Name="OutlineEmpty"
                               DockPanel.Dock="Top"
                               Text="این سند تیتر ندارد."
                               FlowDirection="RightToLeft"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="#98A2B3"
                               Margin="8,0,8,0"
                               IsVisible="False" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="OutlineList" FlowDirection="RightToLeft">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="rendering:OutlineEntry">
                                    <Button Classes="outline"
                                            Classes.active="{Binding IsActive}"
                                            Content="{Binding Title}"
                                            Margin="{Binding Indent}"
                                            Click="OutlineItem_Click"
                                            ToolTip.Tip="{Binding Title}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Background="#F6F8FA"
                BorderBrush="#E3E8EE"
                BorderThickness="0,1,0,0"
                Padding="12,7">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Name="ProgressText"
                               FontSize="12"
                               Foreground="#6B7580"
                               VerticalAlignment="Center"
                               ToolTip.Tip="درصد خوانده‌شده از سند" />
                    <TextBlock x:Name="CountText"
                               FlowDirection="RightToLeft"
                               FontSize="12"
                               Foreground="#6B7580"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="FileText"
                           Text="فایلی باز نشده است"
                           FlowDirection="RightToLeft"
                           TextAlignment="Right"
                           FontSize="12"
                           Foreground="#4B5563"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
