<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MdReader.App"
             RequestedThemeVariant="Light">

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Button.tool">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D5DCE3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Foreground" Value="#24292F" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#EDF1F5" />
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,6,6" />
            <Setter Property="Foreground" Value="#6B7580" />
        </Style>
    </Application.Styles>
</Application>
